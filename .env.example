SERVER_PORT=3001
WEB_PORT=3000
DATABASE_URL=./data/unmanned-library.sqlite
# Off by default; set to true to start the simulator with the server (admins can also press Start on Settings · Simulator).
SIMULATOR_ENABLED=false
SIMULATOR_INTERVAL_MS=5000
SIMULATOR_SEED=42
LOG_LEVEL=info
# Web (web/): shows the demo accounts on /login (staff hint, reader "Simulate scan").
# On for `npm run dev` (web/.env.development), off in the production build (web/.env.production).
# Never enable it on a public deployment.
VITE_DEMO_MODE=true
